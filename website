<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Loomora & Co. | Luxury Artisan Carpets</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        html { scroll-behavior: smooth; }
    </style>
</head>
<body class="bg-stone-50 text-stone-800 font-sans antialiased">

    <nav class="sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-stone-200 dynamic-nav">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-20">
                <div class="flex-shrink-0">
                    <span class="text-2xl font-serif tracking-widest text-amber-900 font-bold">LOOMORA & CO.</span>
                </div>
                <div class="hidden md:flex space-x-8 font-medium text-sm uppercase tracking-wider text-stone-600">
                    <a href="#hero" class="hover:text-amber-800 transition">Home</a>
                    <a href="#collection" class="hover:text-amber-800 transition">Collection</a>
                    <a href="#about" class="hover:text-amber-800 transition">Our Story</a>
                    <a href="#contact" class="hover:text-amber-800 transition">Contact</a>
                </div>
                <div class="flex items-center space-x-4">
                    <button onclick="toggleCart()" class="relative p-2 text-stone-700 hover:text-amber-800 transition focus:outline-none">
                        <i class="fa-solid fa-bag-shopping text-xl"></i>
                        <span id="cart-count" class="absolute top-0 right-0 inline-flex items-center justify-center px-2 py-1 text-xs font-bold leading-none text-white transform translate-x-1/2 -translate-y-1/2 bg-amber-800 rounded-full">0</span>
                    </button>
                </div>
            </div>
        </div>
    </nav>

    <header id="hero" class="relative bg-stone-900 h-[85vh] flex items-center justify-center text-center px-4 overflow-hidden">
        <div class="absolute inset-0 opacity-40 bg-cover bg-center" style="background-image: url('https://images.unsplash.com/photo-1600121848594-d8644e57abab?q=80&w=2070');"></div>
        <div class="relative z-10 max-w-3xl mx-auto">
            <span class="text-amber-400 uppercase tracking-widest text-sm font-semibold block mb-3">Woven Elegance</span>
            <h1 class="text-4xl sm:text-6xl font-serif text-stone-100 mb-6 leading-tight">Artisan Carpets For The Modern Home</h1>
            <p class="text-lg sm:text-xl text-stone-300 mb-8 font-light max-w-2xl mx-auto">Handcrafted masterpieces blending timeless heritage techniques with contemporary design.</p>
            <a href="#collection" class="inline-block bg-amber-800 hover:bg-amber-900 text-white font-medium tracking-wider text-sm uppercase px-8 py-4 transition shadow-lg">Explore Collection</a>
        </div>
    </header>

    <main id="collection" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
        <div class="text-center mb-16">
            <h2 class="text-3xl font-serif text-stone-900 mb-4">The Signature Series</h2>
            <div class="w-16 h-0.5 bg-amber-800 mx-auto mb-4"></div>
            <p class="text-stone-600 max-w-md mx-auto">Carefully curated, sustainably sourced materials, and woven by master craftsmen.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-10">
            <div class="bg-white group border border-stone-200 overflow-hidden shadow-sm hover:shadow-md transition">
                <div class="h-80 bg-stone-200 overflow-hidden relative">
                    <img src="https://images.unsplash.com/photo-1579656335342-bdf9f3fe0de4?q=80&w=600" alt="Persian Medallion" class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
                </div>
                <div class="p-6">
                    <h3 class="font-serif text-xl mb-2 text-stone-900">Persian Medallion</h3>
                    <p class="text-stone-500 text-sm mb-4">Pure premium wool, intricate classical geometric symmetry.</p>
                    <div class="flex justify-between items-center">
                        <span class="text-lg font-semibold text-amber-900">$1,250</span>
                        <button onclick="addToCart('Persian Medallion', 1250)" class="border border-stone-800 text-stone-800 hover:bg-stone-800 hover:text-white px-4 py-2 text-xs uppercase tracking-wider font-medium transition">Add to Cart</button>
                    </div>
                </div>
            </div>

            <div class="bg-white group border border-stone-200 overflow-hidden shadow-sm hover:shadow-md transition">
                <div class="h-80 bg-stone-200 overflow-hidden relative">
                    <img src="https://images.unsplash.com/photo-1600121848594-d8644e57abab?q=80&w=600" alt="Minimalist Silk Shag" class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
                </div>
                <div class="p-6">
                    <h3 class="font-serif text-xl mb-2 text-stone-900">Minimalist Silk Shag</h3>
                    <p class="text-stone-500 text-sm mb-4">Plush high-pile organic silk blend in neutral cream tones.</p>
                    <div class="flex justify-between items-center">
                        <span class="text-lg font-semibold text-amber-900">$890</span>
                        <button onclick="addToCart('Minimalist Silk Shag', 890)" class="border border-stone-800 text-stone-800 hover:bg-stone-800 hover:text-white px-4 py-2 text-xs uppercase tracking-wider font-medium transition">Add to Cart</button>
                    </div>
                </div>
            </div>

            <div class="bg-white group border border-stone-200 overflow-hidden shadow-sm hover:shadow-md transition">
                <div class="h-80 bg-stone-200 overflow-hidden relative">
                    <img src="https://images.unsplash.com/photo-1534349762230-e0cadf78f5db?q=80&w=600" alt="Nomadic Terracotta" class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
                </div>
                <div class="p-6">
                    <h3 class="font-serif text-xl mb-2 text-stone-900">Nomadic Terracotta</h3>
                    <p class="text-stone-500 text-sm mb-4">Tribal flatweave featuring earth-toned natural dyes.</p>
                    <div class="flex justify-between items-center">
                        <span class="text-lg font-semibold text-amber-900">$640</span>
                        <button onclick="addToCart('Nomadic Terracotta', 640)" class="border border-stone-800 text-stone-800 hover:bg-stone-800 hover:text-white px-4 py-2 text-xs uppercase tracking-wider font-medium transition">Add to Cart</button>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <section id="about" class="bg-stone-100 py-20 border-t border-b border-stone-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
            <div>
                <span class="text-amber-800 font-semibold tracking-wider text-xs uppercase block mb-2">Heritage & Craft</span>
                <h2 class="text-3xl font-serif text-stone-900 mb-6">Designed to last generations</h2>
                <p class="text-stone-600 mb-4 leading-relaxed">At Loomora & Co., we believe a carpet isn't just a home accessory—it's the anchor of a room's soul. Every piece is ethically sourced and hand-knotted by traditional weavers using ancient heritage patterns reimagined for contemporary interior architecture.</p>
                <p class="text-stone-600 leading-relaxed">We utilize exclusively organic dyes and sustainably gathered New Zealand wool to protect the environment while supplying luxury comfort directly to your doorstep.</p>
            </div>
            <div class="h-96 bg-stone-300 shadow-lg overflow-hidden">
                <img src="https://images.unsplash.com/photo-1540555700478-4be289fbecef?q=80&w=800" alt="Weaving process" class="w-full h-full object-cover">
            </div>
        </div>
    </section>

    <section id="contact" class="max-w-3xl mx-auto px-4 py-20">
        <div class="text-center mb-12">
            <h2 class="text-3xl font-serif text-stone-900 mb-2">Bespeak Consultations</h2>
            <p class="text-stone-600">Need custom sizing or styling advice? Reach out to our design concierge.</p>
        </div>
        <form onsubmit="handleContactSubmit(event)" class="space-y-6 bg-white p-8 border border-stone-200 shadow-sm">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-stone-600 mb-2">Name</label>
                    <input type="text" required class="w-full border border-stone-300 p-3 text-sm focus:outline-none focus:border-amber-800 bg-stone-50">
                </div>
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-stone-600 mb-2">Email</label>
                    <input type="email" required class="w-full border border-stone-300 p-3 text-sm focus:outline-none focus:border-amber-800 bg-stone-50">
                </div>
            </div>
            <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-stone-600 mb-2">Message</label>
                <textarea rows="4" required class="w-full border border-stone-300 p-3 text-sm focus:outline-none focus:border-amber-800 bg-stone-50"></textarea>
            </div>
            <button type="submit" class="w-full bg-stone-900 hover:bg-stone-800 text-white font-medium tracking-wider text-xs uppercase py-4 transition">Send Message</button>
        </form>
    </section>

    <footer class="bg-stone-950 text-stone-400 py-12 border-t border-stone-900 text-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row justify-between items-center gap-6">
            <p>&copy; 2026 Loomora & Co. All rights reserved.</p>
            <div class="flex space-x-6 text-lg text-stone-400">
                <a href="#" class="hover:text-stone-200"><i class="fa-brands fa-instagram"></i></a>
                <a href="#" class="hover:text-stone-200"><i class="fa-brands fa-pinterest"></i></a>
                <a href="#" class="hover:text-stone-200"><i class="fa-brands fa-facebook"></i></a>
            </div>
        </div>
    </footer>

    <div id="cart-sidebar" class="fixed inset-y-0 right-0 max-w-md w-full bg-white shadow-2xl z-50 transform translate-x-full transition-transform duration-300 ease-in-out border-l border-stone-200 flex flex-col">
        <div class="p-6 border-b border-stone-200 flex justify-between items-center">
            <h3 class="font-serif text-xl text-stone-900">Your Shopping Bag</h3>
            <button onclick="toggleCart()" class="text-stone-500 hover:text-stone-800 text-xl"><i class="fa-solid fa-xmark"></i></button>
        </div>
        
        <div id="cart-items" class="flex-1 overflow-y-auto p-6 space-y-4">
            <p class="text-stone-500 text-center py-8">Your bag is currently empty.</p>
        </div>

        <div class="p-6 border-t border-stone-200 bg-stone-50">
            <div class="flex justify-between items-center mb-6">
                <span class="text-stone-600 font-medium">Subtotal</span>
                <span id="cart-subtotal" class="text-xl font-semibold text-stone-900">$0.00</span>
            </div>
            <button onclick="checkoutAlert()" class="w-full bg-amber-800 hover:bg-amber-900 text-white py-4 font-medium tracking-wider text-xs uppercase transition shadow-md">Proceed to Checkout</button>
        </div>
    </div>

    <script>
        let cart = [];

        function toggleCart() {
            const sidebar = document.getElementById('cart-sidebar');
            sidebar.classList.toggle('translate-x-full');
        }

        function addToCart(name, price) {
            // Check if item already exists in cart
            const existingItem = cart.find(item => item.name === name);
            if (existingItem) {
                existingItem.quantity += 1;
            } else {
                cart.push({ name, price, quantity: 1 });
            }
            updateCartUI();
            
            // Auto open cart to show item added
            const sidebar = document.getElementById('cart-sidebar');
            if(sidebar.classList.contains('translate-x-full')) {
                toggleCart();
            }
        }

        function removeFromCart(name) {
            cart = cart.filter(item => item.name !== name);
            updateCartUI();
        }

        function updateCartUI() {
            const cartItemsContainer = document.getElementById('cart-items');
            const cartCount = document.getElementById('cart-count');
            const cartSubtotal = document.getElementById('cart-subtotal');
            
            // Update total quantity count badge
            const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);
            cartCount.innerText = totalItems;

            if (cart.length === 0) {
                cartItemsContainer.innerHTML = '<p class="text-stone-500 text-center py-8">Your bag is currently empty.</p>';
                cartSubtotal.innerText = '$0.00';
                return;
            }

            let html = '';
            let total = 0;

            cart.forEach(item => {
                const itemTotal = item.price * item.quantity;
                total += itemTotal;
                html += `
                    <div class="flex justify-between items-center border-b border-stone-100 pb-4">
                        <div>
                            <h4 class="font-medium text-stone-900">${item.name}</h4>
                            <p class="text-xs text-stone-500">$${item.price} x ${item.quantity}</p>
                        </div>
                        <div class="flex items-center space-x-4">
                            <span class="font-semibold text-stone-900">$${itemTotal}</span>
                            <button onclick="removeFromCart('${item.name}')" class="text-stone-400 hover:text-red-700 transition">
                                <i class="fa-regular fa-trash-can"></i>
                            </button>
                        </div>
                    </div>
                `;
            });

            cartItemsContainer.innerHTML = html;
            cartSubtotal.innerText = `$${total.toLocaleString()}`;
        }

        function checkoutAlert() {
            if(cart.length === 0) {
                alert("Your shopping bag is empty!");
                return;
            }
            alert("Checkout integration placeholder. In a production environment, this triggers your payment gateway (like Shopify, Stripe, or PayPal).");
        }

        function handleContactSubmit(e) {
            e.preventDefault();
            alert("Thank you for contacting Loomora & Co.! Our design concierge will get back to you shortly.");
            e.target.reset();
        }
    </script>
</body>
</html>
